APP_NAME=BlessLuxe
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=blessluxe
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# ─── Realtime: three ways to run it, two of them free ──────────────────────
#
#  A) POLLING ONLY — no socket, no vendor, no fee.
#       BROADCAST_CONNECTION=null   and   VITE_REALTIME_DRIVER=none
#     Messages, ticks, unread badges and the admin inbox all work. New messages
#     land within ~5s in an active chat (up to 30s in a quiet one). You lose the
#     typing/online indicators and voice/video calls. A quiet poll is 4 indexed
#     queries (<1 ms of database), so one PHP worker carries ~3,000 open inboxes.
#
#  B) FREE HOSTED SOCKET + automatic overflow to polling.  <- recommended
#       BROADCAST_CONNECTION=pusher  and  VITE_REALTIME_DRIVER=pusher
#     Pusher Sandbox: 100 concurrent connections, 200k messages/day, free.
#     Ably free (via its Pusher adapter, set PUSHER_HOST): 200 connections.
#     The app only holds a connection while a chat is OPEN and drops it ~20s
#     after, so the cap is "chats open at the same instant", not users. If the
#     cap is ever hit, the extra visitor is refused and their inbox simply polls
#     (option A) — it degrades, it never bills. In the provider dashboard turn
#     ON "client events" (typing + call signalling need them).
#
#  C) REVERB — self-hosted (needs a server) or Laravel Cloud managed (paid).
#       BROADCAST_CONNECTION=reverb  and  VITE_REALTIME_DRIVER=reverb
#     Locally: php artisan reverb:start
#
# Default: option A (polling only) — what production runs. With `reverb` or
# `pusher` here and the keys below left blank, every broadcast throws.
BROADCAST_CONNECTION=null
VITE_REALTIME_DRIVER=none

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=mt1
# Only for a Pusher-PROTOCOL service that isn't Pusher itself (Ably adapter, Soketi).
PUSHER_HOST=
VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"
VITE_PUSHER_HOST="${PUSHER_HOST}"
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# ─── Realtime (Laravel Reverb) ──────────────────────────────────────────────
# On Laravel Cloud, adding a WebSocket resource fills REVERB_* in for you.
# The VITE_* copies are read at BUILD time — change them and you must rebuild.
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST=127.0.0.1
REVERB_PORT=8080
REVERB_SCHEME=http
# Broadcasts are sent inside the request (no queue worker in production), so
# they are capped: a socket server that is down costs a send ~1.5s, not a hang.
REVERB_CONNECT_TIMEOUT=0.5
REVERB_TIMEOUT=1.5
# WebRTC offers ride Reverb client events; the 10 KB default can truncate one.
REVERB_APP_MAX_MESSAGE_SIZE=64000
# Only when running MORE THAN ONE self-hosted Reverb node (needs Redis).
REVERB_SCALING_ENABLED=false

VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

# ─── Calls (WebRTC) ─────────────────────────────────────────────────────────
# Optional TURN relay. Without it ~15-20% of networks cannot connect a call.
# Prefer TURN_SECRET (coturn use-auth-secret): credentials expire on their own.
TURN_URL=
TURN_USERNAME=
TURN_CREDENTIAL=
TURN_SECRET=
TURN_TTL=3600

# ─── Uploaded + AI-generated files (App\Services\Media) ─────────────────────
# Locally: `public` (storage/app/public, served at /storage). Nothing to set up.
#
# PRODUCTION MUST USE A BUCKET. Laravel Cloud rebuilds the app's own disk on
# every deploy, so anything saved there — product photos, banners, chat images,
# AI renders — is lost. In Laravel Cloud:
#   1. Environment → Add bucket → Laravel Object Storage → visibility PUBLIC.
#      Any disk name is fine — the app finds the bucket itself (it is the
#      environment's default disk). No env var needed.
#   2. Deploy.
#   3. In the environment's COMMANDS tab (not your own terminal) run:
#        php artisan media:check    write / read / public URL / delete
#        php artisan media:push     copies files already on the server
# Old links (/storage/…, /ai/…, /uploads/…) keep working — they redirect.
#
# Leave MEDIA_DISK empty unless you have several buckets and must name one.
MEDIA_DISK=
# Only for a bucket Laravel Cloud did not configure for you (plain R2 / S3):
MEDIA_URL=

# ─── Payment gateways ──────────────────────────────────────────────────────
# Credentials only. Which gateway is ON, and which payment method (EcoCash,
# OneMoney, InnBucks, ZIPIT, cards) goes to which gateway, is chosen by staff
# at /admin/payments. A gateway with no credentials can't be switched on.
#
# Paynow (hosted page: the customer picks EcoCash / OneMoney / ZIPIT / card there)
PAYNOW_INTEGRATION_ID=
PAYNOW_INTEGRATION_KEY=
# Both must be PUBLIC https URLs. resulturl is Paynow's server-to-server callback.
PAYNOW_RESULT_URL="${APP_URL}/api/store/payments/paynow/ipn"
PAYNOW_RETURN_URL="${APP_URL}/api/store/payments/paynow/return"
PAYNOW_AUTH_EMAIL_OVERRIDE=
#
# VelocityAfrica (direct: EcoCash is a USSD prompt on the customer's phone,
# cards redirect). Key from https://app.velocityafrica.net. No webhooks — we poll.
VELOCITY_API_KEY=
VELOCITY_BASE_URL=https://api.velocityafrica.net
VELOCITY_MERCHANT_PHONE=+2637XXXXXXXX
VELOCITY_MERCHANT_ACCOUNT=2637XXXXXXXX
VELOCITY_REGION=ZW
VELOCITY_ITEM_CODE=BLESSLUXE-ORDER
